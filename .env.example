# ==========================================
# EDUFIN — Environment Variables
# ==========================================
# Cara setup:
#   1. Copy file ini: cp .env.example .env.local
#   2. Isi semua nilai yang diperlukan
#   3. JANGAN commit .env.local ke Git!
#
# ⚠️  File ini (.env.example) BOLEH di-commit ke Git
#     karena tidak berisi nilai asli — hanya template.
# ==========================================

# ─── 1. Supabase (Database & Auth) ───────────────────────────────
# Dapatkan dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── 2. Xendit (Payment Gateway — menggantikan Midtrans) ─────────
# Dapatkan dari: Xendit Dashboard → Settings → API Keys
# VITE_ prefix = aman untuk frontend (public key)
# SERVER_ prefix = hanya di Edge Functions (secret key)
VITE_XENDIT_PUBLIC_KEY=xnd_public_development_...

# Secret key HANYA untuk Supabase Edge Functions (bukan VITE_)
# Set di: Supabase Dashboard → Edge Functions → Secrets
# XENDIT_SECRET_KEY=xnd_development_...
# XENDIT_CALLBACK_TOKEN=...

# ─── 3. WhatsApp Notifications (Fonnte) ──────────────────────────
# Set di: Supabase Dashboard → Edge Functions → Secrets
# FONNTE_TOKEN=...

# ─── 4. App Configuration ────────────────────────────────────────
VITE_APP_NAME=EDUFIN
VITE_APP_URL=http://localhost:5173

# Mode: 'development' | 'production'
# Vite otomatis set ini — tidak perlu diubah manual
# NODE_ENV=development

# ─── 5. Sentry Error Tracking (Opsional) ─────────────────────────
# Dapatkan dari: sentry.io → Project Settings → Client Keys
# VITE_SENTRY_DSN=https://...@sentry.io/...
