# ==========================================
# EDUFIN V2 - Environment Variables
# ==========================================
# Salin file ini menjadi `.env.local` dan isi dengan konfigurasi yang benar.

# 1. Supabase (Database & Auth)
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=ey...

# 2. Midtrans (Payment Gateway)
# Dapatkan dari: Dashboard Midtrans Sandbox -> Settings -> Access Keys
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-...
VITE_MIDTRANS_SERVER_KEY=SB-Mid-server-...
